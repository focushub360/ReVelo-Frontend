# Local backend. Leave VITE_API_BASE_URL unset to use Vite's same-origin /api/v1 proxy.
VITE_DEV_API_TARGET=http://localhost:5000
# Optional API base URL override. Normally leave unset:
# local Vite proxies /api/v1 to localhost:5000, and production Vercel proxies it
# to https://revelo-backend-wll7.onrender.com/api/v1.
# VITE_API_BASE_URL=
